{
  "multipart": [
    { "apply": { "model": "tremendousstorage:block/ender_chest_particle" } },

    { "when": { "facing": "north", "south": "true" }, "apply": { "model": "tremendousstorage:block/chest_attachment", "y": 180 } },
    { "when": { "facing": "north", "east": "true"  }, "apply": { "model": "tremendousstorage:block/chest_attachment", "y": 90 } },
    { "when": { "facing": "north", "west": "true"  }, "apply": { "model": "tremendousstorage:block/chest_attachment", "y": 270 } },

    { "when": { "facing": "south", "north": "true" }, "apply": { "model": "tremendousstorage:block/chest_attachment" } },
    { "when": { "facing": "south", "east": "true"  }, "apply": { "model": "tremendousstorage:block/chest_attachment", "y": 90 } },
    { "when": { "facing": "south", "west": "true"  }, "apply": { "model": "tremendousstorage:block/chest_attachment", "y": 270 } },

    { "when": { "facing": "east", "north": "true" }, "apply": { "model": "tremendousstorage:block/chest_attachment" } },
    { "when": { "facing": "east", "south": "true" }, "apply": { "model": "tremendousstorage:block/chest_attachment", "y": 180 } },
    { "when": { "facing": "east", "west": "true"  }, "apply": { "model": "tremendousstorage:block/chest_attachment", "y": 270 } },

    { "when": { "facing": "west", "north": "true" }, "apply": { "model": "tremendousstorage:block/chest_attachment" } },
    { "when": { "facing": "west", "south": "true" }, "apply": { "model": "tremendousstorage:block/chest_attachment", "y": 180 } },
    { "when": { "facing": "west", "east": "true"  }, "apply": { "model": "tremendousstorage:block/chest_attachment", "y": 90 } }
  ]
}
